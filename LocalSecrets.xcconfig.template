// LocalSecrets.xcconfig.template
// Copy this file to LocalSecrets.xcconfig and fill in your keys
// LocalSecrets.xcconfig is gitignored and will not be committed

HELICONE_API_KEY = your-api-key-here

// REQUIRED for Archive/App Store: Use Production (Apple) API key from RevenueCat
// Dashboard → Project → API Keys → Apple Public Key (NOT the Test Store key!)
// Test Store keys (test_xxx) cause crashes in production
REVENUECAT_APPLE_API_KEY = your-revenuecat-production-key-here
