{"translation":{"id":"spa_r09","name":"Santa Biblia — Reina Valera 1909","website":"https://ebible.org/Scriptures/details.php?id=spaRV1909","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spaRV1909","licenseNotes":null,"shortName":"R09","englishName":"Reina Valera 1909","language":"spa","textDirection":"ltr","sha256":"94e154b2e6e56eda1702d9e9f664357a5f2aa82634b551111b0b698d124e97d5","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_r09/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_r09","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"41980fc6b31dd63b44f0c2293fdf109803e97b201316f8b64fc031959e2a7261","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_r09/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_r09/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":["Aleluya. CANTAD á Jehová canción nueva: su alabanza sea en la congregación de los santos."]},{"type":"verse","number":2,"content":["Alégrese Israel en su Hacedor: los hijos de Sión se gocen en su Rey."]},{"type":"verse","number":3,"content":["Alaben su nombre con corro: con adufe y arpa á él canten."]},{"type":"verse","number":4,"content":["Porque Jehová toma contentamiento con su pueblo: hermoseará á los humildes con salud."]},{"type":"verse","number":5,"content":["Gozarse han los píos con gloria: cantarán sobre sus camas."]},{"type":"verse","number":6,"content":["Ensalzamientos de Dios modularán en sus gargantas, y espadas de dos filos habrá en sus manos;"]},{"type":"verse","number":7,"content":["Para hacer venganza de las gentes, y castigo en los pueblos;"]},{"type":"verse","number":8,"content":["Para aprisionar sus reyes en grillos, y sus nobles con cadenas de hierro;"]},{"type":"verse","number":9,"content":["Para ejecutar en ellos el juicio escrito: gloria será esta para todos sus santos. Aleluya."]}],"footnotes":[]},"thisChapterLink":"/api/spa_r09/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_r09/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_r09/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}