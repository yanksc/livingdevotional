ões."]}],"footnotes":[]},"thisChapterLink":"/api/por_blj/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/por_blj/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/por_blj/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}